{
	"editor.formatOnSave": true,
	// Range formatting corrupts this repo: Prettier runs `semi: false`, so a
	// modified range starting with `(` gets an ASI guard spliced mid-expression.
	"editor.formatOnSaveMode": "file",
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	// Language overrides beat the general default above, so JSON needs its own
	// entry or the built-in formatter expands arrays that Prettier keeps inline.
	"[json]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"prettier.useEditorConfig": false,
	"prettier.configPath": ".prettierrc",
	"prettier.requireConfig": true,
	"prettier.prettierPath": "./node_modules/prettier",
	"tailwindCSS.experimental.configFile": "src/app.css",
	"tailwindCSS.lint.suggestCanonicalClasses": "ignore",
	"tailwindCSS.classFunctions": ["tw"],
	"chat.tools.terminal.autoApprove": {
		"npx vitest": true
	}
}
