{
	"extends": "./tsconfig.strict.json",
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023"],
		"baseUrl": ".",
		"ignoreDeprecations": "6.0",
		"paths": {
			"#lib/*": ["src/lib/*"]
		},
		"allowImportingTsExtensions": true,
		"noEmit": true
	},
	"include": ["src/lib/domain/**/*.ts"]
}
