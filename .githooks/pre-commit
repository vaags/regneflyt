#!/bin/sh
# Release metadata, formatting, and lint gate for staged content.
# ESLint's parse errors catch the stray-token corruption that has slipped into
# commits before.
# Deliberately excludes svelte-check, tsc, and the unit suite: too slow here,
# `npm run verify` covers them.
set -e

# quotePath would octal-escape and quote non-ASCII paths, which the tools below
# then cannot open.
git_paths() {
	git -c core.quotePath=false "$@"
}

staged_all=$(git_paths diff --cached --name-only --diff-filter=ACMR)

package_staged=false
lockfile_staged=false
printf '%s\n' "$staged_all" | grep -Fxq 'package.json' && package_staged=true
printf '%s\n' "$staged_all" | grep -Fxq 'package-lock.json' && lockfile_staged=true

if [ "$package_staged" = true ] || [ "$lockfile_staged" = true ]; then
	package_version=$(git show ':package.json' | node -e \
		"let input=''; process.stdin.on('data', chunk => input += chunk); process.stdin.on('end', () => console.log(JSON.parse(input).version))")
	lock_versions=$(git show ':package-lock.json' | node -e \
		"let input=''; process.stdin.on('data', chunk => input += chunk); process.stdin.on('end', () => { const lock = JSON.parse(input); console.log(lock.version); console.log(lock.packages?.['']?.version ?? ''); })")
	lockfile_version=$(printf '%s\n' "$lock_versions" | sed -n '1p')
	root_package_version=$(printf '%s\n' "$lock_versions" | sed -n '2p')

	if [ "$package_version" != "$lockfile_version" ] || [ "$package_version" != "$root_package_version" ]; then
		printf '%s\n' 'Commit blocked: package.json and package-lock.json versions must match.' >&2
		exit 1
	fi

	head_version=$(git show 'HEAD:package.json' | node -e \
		"let input=''; process.stdin.on('data', chunk => input += chunk); process.stdin.on('end', () => console.log(JSON.parse(input).version))")

	if [ "$package_version" != "$head_version" ]; then
		if ! printf '%s\n' "$staged_all" | grep -Fxq 'CHANGELOG.md'; then
			printf '%s\n' 'Commit blocked: a version bump must stage CHANGELOG.md.' >&2
			exit 1
		fi

		if ! git show ':CHANGELOG.md' | grep -Fq "## [$package_version]"; then
			printf '%s\n' "Commit blocked: CHANGELOG.md must contain a section for version $package_version." >&2
			exit 1
		fi
	fi
fi

unstaged=$(mktemp)
trap 'rm -f "$unstaged"' EXIT
git_paths diff --name-only >"$unstaged"

# ESLint has no config for json/css/md and reports them as warnings, which
# --max-warnings=0 would turn into a failed commit.
formattable='\.(ts|svelte|js|mjs|json|css|md)$'
lintable='\.(ts|svelte|js|mjs)$'

staged=$(printf '%s\n' "$staged_all" |
	grep -E "$formattable" || true)

# Without unstaged changes a path's working-tree copy is byte-identical to its
# staged blob, so the fast batched run still judges what the commit records.
batched=$(printf '%s\n' "$staged" | grep -Fxv -f "$unstaged" || true)
piped=$(printf '%s\n' "$staged" | grep -Fx -f "$unstaged" || true)

# GNU xargs runs the command once even with empty input (BSD does not), which
# would format or lint the whole repository.
if [ -n "$batched" ]; then
	printf '%s\n' "$batched" | tr '\n' '\0' | xargs -0 npx prettier --check

	batched_lintable=$(printf '%s\n' "$batched" | grep -E "$lintable" || true)
	if [ -n "$batched_lintable" ]; then
		printf '%s\n' "$batched_lintable" |
			tr '\n' '\0' | xargs -0 npx eslint --max-warnings=0
	fi
fi

# Partially staged: the working-tree copy is not what the commit records, so
# check the staged blob instead. --stdin-filepath/--stdin-filename keep Prettier
# config and ESLint's TypeScript project lookup anchored to the real path.
printf '%s\n' "$piped" | while IFS= read -r path; do
	[ -n "$path" ] || continue
	blob=$(git show ":$path")

	# Prettier exits 0 on a parse error over stdin, so ESLint is the syntax gate.
	printf '%s\n' "$blob" | npx prettier --check --stdin-filepath "$path"

	case "$path" in
	*.ts | *.svelte | *.js | *.mjs)
		printf '%s\n' "$blob" |
			npx eslint --stdin --stdin-filename "$path" --max-warnings=0
		;;
	esac
done
